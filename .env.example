# AgriNet node configuration — copy to .env and fill in secrets.
# NEVER commit .env (it is gitignored).

# --- Secrets ---
# Google AI Studio key (https://aistudio.google.com/apikey). Leave empty to run in DEMO_MODE.
GEMINI_API_KEY=

# --- Node identity ---
# Which state this node represents: TS (Telangana) or OD (Odisha).
STATE_ID=TS
PORT=8001

# Comma-separated base URLs of peer nodes in the federation.
# Local two-node dev: the TS node (8001) peers with OD (8002) and vice versa.
PEERS=http://localhost:8002

# --- Behaviour flags ---
# 1 = serve canned/cached Gemini responses (no API key needed, quota-safe demo).
# 0 = call the Gemini API live (requires GEMINI_API_KEY).
DEMO_MODE=1

# 1 = if a live Gemini call fails (quota exhausted, invalid key, no network),
# automatically serve the canned demo response instead of erroring.
DEMO_FALLBACK=1

# Gemini model to use in live mode.
GEMINI_MODEL=gemini-flash-latest

# 1 = use live Google Earth Engine (requires earthengine-api + auth).
# 0 = use the pre-computed satellite cache in backend/data/satellite_cache/.
EE_ENABLED=0
# EE_PROJECT=

# Disease reports of the same disease in the same district within
# OUTBREAK_WINDOW_DAYS needed to raise a federation alert.
OUTBREAK_THRESHOLD=3
OUTBREAK_WINDOW_DAYS=7
